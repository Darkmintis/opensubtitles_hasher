<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge: transparent system bars; content draws behind and pads via WindowInsets. -->
    <style name="Theme.OpenSubtitlesHasher.MoviePicker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0B6E4F</item>
        <item name="colorPrimaryContainer">#08563E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
    </style>

    <!-- Overflow "Change folder" popup: dark text on light surface (readable). -->
    <style name="ThemeOverlay.OpenSubtitlesHasher.ToolbarPopup" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1C1B1F</item>
        <item name="android:textColorPrimary">#FF1C1B1F</item>
        <item name="android:textColorSecondary">#FF49454F</item>
    </style>
</resources>
